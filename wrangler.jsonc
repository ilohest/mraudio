{
  // Site statique servi par Cloudflare Workers : pas de code, seulement des fichiers.
  // Le dossier « deploy » est assemblé par scripts/deploy.mjs (application + audios).
  "name": "mraudio",
  "compatibility_date": "2025-11-01",
  "assets": {
    "directory": "./deploy",
    // Toute adresse inconnue reçoit 404.html, avec le code 404.
    "not_found_handling": "404-page"
  },
  // Domaine personnalisé : Cloudflare crée l'enregistrement DNS lui-même, à condition que la
  // zone mraudio.app soit dans le même compte que le Worker.
  "routes": [{ "pattern": "mraudio.app", "custom_domain": true }]
}
